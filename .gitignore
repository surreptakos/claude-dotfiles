# The whitelist in lib/manifest.ps1 is the real guard — sync.ps1 only ever reads
# the files named there. This is the backstop for anything copied in by hand.

.credentials.json
.clasprc.json
.claude.json
client_secret*.json
*gpt-sheets-access*.json
*.pem
*.key
*.p12
credentials*.json
token*.json

# machine state, not configuration
sessions/
shell-snapshots/
history.jsonl
telemetry/
cache/
tmp/
downloads/
hook-state/
node_modules/
__pycache__/
*.pyc
*.log
*.bak
*.bak-*

# Generated by tools/dotfiles-freshness-hook.test.js on each test run - a Node
# stub that stands in for the PowerShell classifier. Deterministic content;
# checking it in would only invite hand edits nobody meant to commit.
tools/__dotfiles-freshness-stub.js

# build output of tools/build-cloud-plugin.py — regenerate, never commit
dist/
