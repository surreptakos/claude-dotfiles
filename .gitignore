# The whitelist in lib/manifest.ps1 is the real guard — sync.ps1 only ever reads
# the files named there. This is the backstop for anything copied in by hand.

.credentials.json
.clasprc.json
.claude.json
client_secret*.json
*gpt-sheets-access*.json
*.pem
*.key
*.p12
credentials*.json
token*.json

# machine state, not configuration
sessions/
shell-snapshots/
history.jsonl
telemetry/
cache/
tmp/
downloads/
hook-state/
node_modules/
__pycache__/
*.pyc
*.log
*.bak
*.bak-*

# Generated by tools/dotfiles-freshness-hook.test.js on each test run - a Node
# stub that stands in for the PowerShell classifier. Deterministic content;
# checking it in would only invite hand edits nobody meant to commit.
tools/__dotfiles-freshness-stub.js

# build output of tools/build-cloud-plugin.py — regenerate, never commit
dist/

# Issue 238: .claude/worktrees holds this repo's own concurrent agent checkouts.
# `git add .` from a parent checkout grabs them as submodules (mode 160000 gitlink
# entries) which breaks every Actions run (`No url found for submodule path`) and
# the restore test's clone-fidelity check. The primary block. The restore-test
# guard is the backstop for a `git add -f`.
.claude/worktrees/
