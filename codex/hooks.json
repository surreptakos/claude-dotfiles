{
  "description": "Global Ask Matt route gate for every Codex turn.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/plugins/marketplaces/claude-dotfiles/marketplace/aac-skills/hooks/scripts/ask_matt_gate.py\" prompt",
            "commandWindows": "py -3 \"__USERHOME_JSON__\\.claude\\plugins\\marketplaces\\claude-dotfiles\\marketplace\\aac-skills\\hooks\\scripts\\ask_matt_gate.py\" prompt",
            "timeout": 5,
            "statusMessage": "Starting Ask Matt route gate",
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/plugins/marketplaces/claude-dotfiles/marketplace/aac-skills/hooks/scripts/ask_matt_gate.py\" pre-tool",
            "commandWindows": "py -3 \"__USERHOME_JSON__\\.claude\\plugins\\marketplaces\\claude-dotfiles\\marketplace\\aac-skills\\hooks\\scripts\\ask_matt_gate.py\" pre-tool",
            "timeout": 5,
            "statusMessage": "Checking Ask Matt route"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/plugins/marketplaces/claude-dotfiles/marketplace/aac-skills/hooks/scripts/ask_matt_gate.py\" stop",
            "commandWindows": "py -3 \"__USERHOME_JSON__\\.claude\\plugins\\marketplaces\\claude-dotfiles\\marketplace\\aac-skills\\hooks\\scripts\\ask_matt_gate.py\" stop",
            "timeout": 5,
            "statusMessage": "Verifying Ask Matt route"
          }
        ]
      }
    ]
  }
}
