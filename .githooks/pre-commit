#!/bin/sh
# Repo test gate, installed by the project-harness skill. Activate per clone:
#   git config core.hooksPath .githooks
# Bypass for a genuine emergency: git commit --no-verify (CI still gates).
# TEST_COMMAND is substituted by the harness skill at install time.
echo "pre-commit: restore test (~13s)"
powershell -ExecutionPolicy Bypass -File tests/restore-test.ps1 -From worktree || {
  echo ""
  echo "pre-commit: test suite failed — commit blocked."
  exit 1
}
