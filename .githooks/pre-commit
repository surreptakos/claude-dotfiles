#!/bin/sh
# Repo test gate, installed by the project-harness skill. Activate per clone:
#   git config core.hooksPath .githooks
# Bypass for a genuine emergency: git commit --no-verify (CI still gates).
# TEST_COMMAND is substituted by the harness skill at install time.
#
# Issue 28: git invokes this hook with GIT_DIR / GIT_WORK_TREE / GIT_INDEX_FILE / GIT_PREFIX /
# GIT_COMMON_DIR / GIT_OBJECT_DIRECTORY exported into the child environment. Those env
# vars OVERRIDE `git -C <path>` in every downstream tool - the restore-test bootstrap,
# the tracker-audit, the freshness classifier - and silently redirect their git calls
# to this commit's index instead of the target they were told to inspect. Every helper
# also clears them internally as a defence in depth, but strip them here so the whole
# test suite runs under a clean environment from the start.
#
# Issue 406 - the 2026-09-16 aac-routines incident (fixed in that repo as aac-routines#278).
# A commit made from a linked worktree, where GIT_DIR is .git/worktrees/<name>, ran this hook
# and the suite's own `git init` / `git config` in a temp directory acted on the REAL repository
# instead: a BLOCKED commit left the main checkout's .git/config carrying core.bare = true and a
# test identity in [user], and every worktree answered `fatal: this operation must be run in a
# work tree` until it was repaired by hand. GIT_PREFIX joins the list for the same reason - git
# exports the hook's cwd-relative prefix too. Never drop this line.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR GIT_OBJECT_DIRECTORY

# Issue 395: `node --test` exports NODE_TEST_CONTEXT into everything it spawns, and a nested
# `node --test` that inherits it exits 0 even when a test throws. A commit made from inside a
# node test would run this gate with the variable set and the suite could never fail it.
unset NODE_TEST_CONTEXT

# Issue 454: the suite spawns whichever engine started it, so name the one that exists here -
# Windows PowerShell on the desktop, pwsh 7 in a Linux container. `pwsh` accepts and ignores
# -ExecutionPolicy off Windows, so one argument list serves both.
#
# `powershell` FIRST, not pwsh: the desktop has both (pwsh 7.6.5 since 2026-08-31), and 5.1
# is the engine this suite has always run on. ConvertTo-Json alone indents 4 spaces there and
# 2 under 7, so preferring pwsh where it exists would change what the gate measures on the one
# machine the gate was written for. A container has no `powershell` at all, so it still gets
# pwsh. Neither on PATH is a loud SKIP, never a block: a missing interpreter is not a failing
# test.
PS_ENGINE=
if command -v powershell >/dev/null 2>&1; then
  PS_ENGINE=powershell
elif command -v pwsh >/dev/null 2>&1; then
  PS_ENGINE=pwsh
fi

if [ -z "$PS_ENGINE" ]; then
  echo "pre-commit: NOTE - no pwsh or powershell on PATH; restore test SKIPPED (not run, not passed)."
else
  echo "pre-commit: restore test (~13s)"
  "$PS_ENGINE" -ExecutionPolicy Bypass -File tests/restore-test.ps1 -From worktree || {
    echo ""
    echo "pre-commit: test suite failed — commit blocked."
    exit 1
  }
fi
